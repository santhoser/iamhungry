{
  "name": "cafe77",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "format": "prettier --write --ignore-unknown src server shared workers migrations scripts tests config cloudflare *.json *.jsonc *.ts *.md index.html",
    "staff:create": "tsx scripts/create-staff.ts",
    "test:workers": "npm run build:workers && tsx --test tests/workers/*.test.ts",
    "test:ui:workers": "npm run build:workers && playwright test --config playwright.workers.config.ts",
    "build:workers": "npm run build && wrangler deploy --env staging --dry-run --outdir data/worker-bundle --no-autoconfig",
    "db:workers:local": "node scripts/wrangler-local.mjs d1 migrations apply DB --env staging --local",
    "dev:workers": "node scripts/wrangler-local.mjs dev --env staging --local --port 8788"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wrangler": "4.149.0"
  }
}
