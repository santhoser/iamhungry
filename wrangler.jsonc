{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cafe77",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "env": {
    "staging": {
      "name": "cafe77-staging",
      "main": "workers/app.ts",
      "account_id": "0b5269aeaac37eabf9becf59d0098612",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/uploads/*"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cafe77-staging-db",
          "database_id": "bac5296e-2f87-4362-a5b9-56c2693e2200",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
