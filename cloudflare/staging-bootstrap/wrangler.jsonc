{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cafe77-bootstrap",
  "account_id": "0b5269aeaac37eabf9becf59d0098612",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "cafe77-staging",
      "main": "worker.mjs",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cafe77-staging-db",
          "database_id": "bac5296e-2f87-4362-a5b9-56c2693e2200",
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
  },
}
